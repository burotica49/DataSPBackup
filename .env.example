# ---------------------------------------------------------------------------
# dataspbackup — configuration
# Copier en .env et remplir. NE JAMAIS committer le .env rempli.
# ---------------------------------------------------------------------------

# Port HTTP du serveur (interface + API)
PORT=4005

# Répertoire des données persistantes (métadonnées SQLite + sauvegardes locales)
DATA_DIR=/data

# Clé maître de chiffrement des sauvegardes et des secrets stockés.
# 32 octets en hex (64 caractères). Générer avec:
#   openssl rand -hex 32
# Si vide au démarrage, le serveur refuse de démarrer (pas de secret par défaut).
MASTER_KEY=

# Secret de signature des jetons de session (JWT). Générer avec openssl rand -hex 32
JWT_SECRET=

# Compte administrateur initial (créé au premier démarrage uniquement).
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=

# Chemin du socket Docker utilisé pour les conteneurs jetables de vérification
# et pour l'exécution versionnée de pg_dump/pg_restore.
DOCKER_SOCKET=/var/run/docker.sock

# Image de base pour les conteneurs PostgreSQL jetables de vérification.
# {major} est remplacé par la version majeure détectée (ex: 15, 17).
# Par défaut : postgis/postgis, qui embarque PostGIS ET les modules contrib
# (uuid-ossp, pgcrypto…) couvrant les extensions Supabase courantes.
# Pour une couverture complète des extensions Supabase (pgjwt, pg_graphql…),
# pointer vers une image Supabase ou une image personnalisée.
VERIFY_PG_IMAGE=postgis/postgis:{major}-3.5
# Repli si l'image ci-dessus est indisponible (ATTENTION: pas de PostGIS).
VERIFY_PG_IMAGE_FALLBACK=postgres:{major}
# Image prioritaire PAR VERSION MAJEURE (JSON) : pour couvrir les extensions
# internes Supabase (pgsodium, supabase_vault, pg_graphql…), pointer vers une
# image Supabase complète correspondant à la version de la source.
# VERIFY_PG_IMAGE_MAP={"15":"supabase/postgres:15.8.1.060","17":"supabase/postgres:17.4.1.054"}
VERIFY_PG_IMAGE_MAP=

# Niveau de log: debug | info | warn | error
LOG_LEVEL=info
